APP_NAME=Gryffindor Backend
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55433/gryffindor
RECOGNITION_PROVIDER=mock
MOCK_RECOGNITION_STATUS=MATCHED
MOCK_RECOGNITION_PRODUCT_ID=test_outer_001
RECOGNITION_MAX_IMAGE_BYTES=5242880
RECOGNITION_MAX_CANDIDATES=20
RECOGNITION_DEBUG_SAVE_IMAGES=false
RECOGNITION_DEBUG_IMAGE_DIR=artifacts/recognition_crops
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
OPENCLIP_DEVICE=auto
OPENCLIP_EMBEDDING_DIMENSION=512
OPENCLIP_MATCH_THRESHOLD=0.80
OPENCLIP_MARGIN_THRESHOLD=0.20
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=20
